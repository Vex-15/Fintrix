# Database
DATABASE_URL=postgresql+asyncpg://fintrix:fintrix@localhost:5432/fintrix

# LLM (pick one or both)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key
LLM_PROVIDER=gemini  # gemini | openai

# AI Guardrails
AUTO_RESOLVE_CONFIDENCE_THRESHOLD=0.85
AUTO_RESOLVE_MAX_AMOUNT_PAISE=1000000  # ₹10,000
ALWAYS_ESCALATE_AMOUNT_PAISE=10000000  # ₹1,00,000

# App
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
